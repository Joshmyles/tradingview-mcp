{
  "name": "tradingview-mcp",
  "version": "1.0.0",
  "description": "MCP bridge for TradingView Desktop via Chrome DevTools Protocol",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "tv": "src/cli/index.js"
  },
  "exports": {
    ".": "./src/server.js",
    "./core": "./src/core/index.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "tv": "node src/cli/index.js",
    "lint": "eslint src/ tests/",
    "test": "node --test \"tests/*.test.js\"",
    "test:e2e": "node --test tests/live/e2e.test.js",
    "test:unit": "node --test \"tests/*.test.js\"",
    "test:cli": "node --test tests/cli.test.js",
    "test:all": "npm run test && npm run test:e2e",
    "test:smoke": "node --test tests/live/smoke.test.js",
    "start:diag": "node src/server-diag.js",
    "test:live": "node --test \"tests/live/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "chrome-remote-interface": "^0.33.2"
  },
  "devDependencies": {
    "eslint": "^9.39.4"
  }
}
